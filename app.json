{
  "expo": {
    "name": "Norita",
    "slug": "norita",
    "scheme": "norita",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.norita.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": [
          "es"
        ]
      }
    },
    "android": {
      "package": "com.norita.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Norita usa tus fotos para guardar los resultados de exámenes médicos.",
          "cameraPermission": "Norita usa la cámara para fotografiar los resultados de exámenes médicos.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c981169-6245-4548-b404-3489bc126932"
      }
    },
    "owner": "22andradeb"
  }
}
