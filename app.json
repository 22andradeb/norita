{
  "expo": {
    "name": "Norita",
    "slug": "norita",
    "scheme": "norita",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.norita.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.norita.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
